# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
FLASK_SECRET_KEY=replace-with-a-long-random-value

# This is the password used to open the private web app.
PERMIT_APP_PASSWORD=replace-with-a-strong-password

# Set true only when the app is served to the browser over HTTPS.
COOKIE_SECURE=false
